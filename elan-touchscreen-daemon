import os, fcntl, time
from evdev import UInput, AbsInfo, ecodes as e

I2C_SLAVE = 0x0703
ADDR = 0x10
BUS_PATH = "/dev/i2c-0"
MAX_X = 3888
MAX_Y = 2160
MAX_SLOTS = 5

cap = {
    e.EV_KEY: [e.BTN_TOUCH],
    e.EV_ABS: [
        (e.ABS_X, AbsInfo(value=0, min=0, max=MAX_X, fuzz=0, flat=0, resolution=10)),
        (e.ABS_Y, AbsInfo(value=0, min=0, max=MAX_Y, fuzz=0, flat=0, resolution=10)),
        (e.ABS_MT_POSITION_X, AbsInfo(value=0, min=0, max=MAX_X, fuzz=0, flat=0, resolution=10)),
        (e.ABS_MT_POSITION_Y, AbsInfo(value=0, min=0, max=MAX_Y, fuzz=0, flat=0, resolution=10)),
        (e.ABS_MT_SLOT, AbsInfo(value=0, min=0, max=MAX_SLOTS - 1, fuzz=0, flat=0, resolution=0)),
        (e.ABS_MT_TRACKING_ID, AbsInfo(value=-1, min=-1, max=65535, fuzz=0, flat=0, resolution=0)),
    ]
}

def main():
    ui = UInput(cap, name="ELAN2513 Touchscreen", vendor=0x04f3, product=0x2c3f, input_props=[e.INPUT_PROP_DIRECT])
    fd = os.open(BUS_PATH, os.O_RDWR)
    try:
        fcntl.ioctl(fd, I2C_SLAVE, ADDR)
        os.write(fd, bytes([0x05, 0x00, 0x00, 0x08]))
        time.sleep(0.05)
        
        active_slots = {}
        track_counter = 1
        last_touch_time = 0
        
        while True:
            got_touch = False
            try:
                data = os.read(fd, 67)
                b = list(data)
                
                if len(b) >= 12 and b[0] > 0 and b[0] != 255 and b[2] == 0x01:
                    current_slots_in_packet = set()
                    
                    for slot in range(MAX_SLOTS):
                        offset = slot * 11
                        if 11 + offset < len(b):
                            status = b[3 + offset]
                            tip_switch = status & 0x01
                            x = b[6 + offset] | (b[7 + offset] << 8)
                            y = b[10 + offset] | (b[11 + offset] << 8)
                            
                            if tip_switch and x <= MAX_X and y <= MAX_Y:
                                got_touch = True
                                last_touch_time = time.time()
                                current_slots_in_packet.add(slot)
                                
                                if slot not in active_slots:
                                    track_counter = (track_counter + 1) % 60000
                                    active_slots[slot] = track_counter
                                
                                ui.write(e.EV_ABS, e.ABS_MT_SLOT, slot)
                                ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, active_slots[slot])
                                ui.write(e.EV_ABS, e.ABS_MT_POSITION_X, x)
                                ui.write(e.EV_ABS, e.ABS_MT_POSITION_Y, y)
                                if slot == 0:
                                    ui.write(e.EV_ABS, e.ABS_X, x)
                                    ui.write(e.EV_ABS, e.ABS_Y, y)
                    
                    # Relâcher les slots qui ne sont plus touchés
                    for slot in list(active_slots.keys()):
                        if slot not in current_slots_in_packet:
                            ui.write(e.EV_ABS, e.ABS_MT_SLOT, slot)
                            ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
                            del active_slots[slot]
                    
                    if active_slots:
                        ui.write(e.EV_KEY, e.BTN_TOUCH, 1)
                    else:
                        ui.write(e.EV_KEY, e.BTN_TOUCH, 0)
                    
                    ui.syn()
            except Exception:
                pass
            
            # Relâchement immédiat après 25ms d'inactivité
            if active_slots and (not got_touch) and (time.time() - last_touch_time > 0.025):
                for slot in list(active_slots.keys()):
                    ui.write(e.EV_ABS, e.ABS_MT_SLOT, slot)
                    ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
                active_slots.clear()
                ui.write(e.EV_KEY, e.BTN_TOUCH, 0)
                ui.syn()
                
            time.sleep(0.008)
    finally:
        os.close(fd)
        ui.close()

if __name__ == "__main__":
    main()
